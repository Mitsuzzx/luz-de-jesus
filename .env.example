# Copie para .env (local). Na Vercel, coloque as mesmas chaves em Settings > Environment Variables.
# Sharpify: painel sharpify.com.br > Configurações > Credenciais de API
# Permissões: CREATE_PAYMENT_LINK + GET_PAYMENT_LINK

SHARPIFY_CLIENT_ID=seu_client_id_aqui
SHARPIFY_CLIENT_SECRET=seu_client_secret_aqui
SHARPIFY_BASE=https://sharpify-pay.com

# Webhook público p/ aprovação automática (ex: https://seu-projeto.vercel.app/api/webhook)
WEBHOOK_URL=

# Meta (começa zerada; ajuste pelo painel /admin depois)
GOAL=65000
BASE_RAISED=0
BASE_DONORS=0

# Supabase (OPCIONAL — sem isso o site usa banco local em db.json)
# 1. Crie um projeto em supabase.com > rode o supabase.sql no SQL Editor
# 2. Pegue em Project Settings > API e cole aqui:
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_KEY=sua_service_role_key_aqui
# ⚠️ Use a SERVICE_ROLE (só no servidor/.env, nunca no frontend).
# Na Vercel, adicione as mesmas variáveis em Settings > Environment Variables.

# Senha do painel /admin
ADMIN_PASSWORD=jesus123

# Meta Pixel (tráfego pago) — pode preencher aqui OU pelo painel /admin (recomendado)
META_PIXEL_ID=
# Conversions API (opcional, recomendado: Purchase server-side p/ iOS14+)
META_CAPI_TOKEN=

PORT=3000
